# Lodgify API key used for property listings (server-side only).
LODGIFY_API_KEY=

# n8n integration
# Webhook URL of the n8n workflow that should receive contact form submissions
# (Webhook node in n8n -> "Production URL").
# NOTE: Because the site is a static export, the URL is exposed to the browser.
# In your n8n workflow, restrict the webhook (e.g. allowed origins) and validate
# the payload before processing it.
NEXT_PUBLIC_N8N_WEBHOOK_URL=
