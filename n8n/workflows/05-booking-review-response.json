{
  "name": "05 – Booking.com Bewertung → Antwortvorschlag",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-review",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook – Booking Review",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 300],
      "webhookId": "REPLACE_ME_REVIEW_WEBHOOK_ID"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-secret",
              "leftValue": "={{ $headers['x-booking-signature'] }}",
              "rightValue": "={{ $vars.BOOKING_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-verify",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json.body || $input.first().json;\nreturn [{\n  json: {\n    reviewId: r.id || r.review_id || '',\n    propertyName: r.property?.name || r.hotel_name || '',\n    rating: r.rating ?? r.score ?? null,\n    title: r.title || '',\n    positive: r.positive_text || r.pros || '',\n    negative: r.negative_text || r.cons || '',\n    language: r.language || 'de',\n    guestName: r.guest?.name || r.author || 'Gast',\n    raw: r\n  }\n}];"
      },
      "id": "node-extract",
      "name": "Extract Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 200]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "create",
        "model": "claude-opus-4-7",
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Du formulierst öffentliche Antworten auf Gast-Bewertungen für Move-in2Stay (Möblierte Apartments / Monteurzimmer).\n\nLeitlinien:\n- Persönlich anreden, freundlich, dankbar.\n- Bei Kritik: kurz Bedauern ausdrücken, konkrete Verbesserungs-Maßnahme nennen, NICHT defensiv.\n- Keine Werbe-Floskeln, keine generischen Phrasen.\n- Sprache: {{ $json.language }} (Deutsch wenn unklar).\n- Länge: 60–120 Wörter.\n- Kein Markdown, da Booking.com Plain-Text rendert.\n\nBewertung:\nApartment: {{ $json.propertyName }}\nGast: {{ $json.guestName }}\nBewertung: {{ $json.rating }} / 10\nTitel: {{ $json.title }}\nPositiv: {{ $json.positive }}\nNegativ: {{ $json.negative }}\n\nAntworte als JSON: { \"response\": string, \"tone\": \"warm\" | \"apologetic\" | \"neutral\", \"flag_for_human\": boolean }\nflag_for_human = true wenn Bewertung ≤ 5/10 oder rechtliche/ heikle Themen erwähnt sind."
            }
          ]
        },
        "options": {
          "maxTokens": 700,
          "temperature": 0.5
        }
      },
      "id": "node-claude",
      "name": "Claude – Response",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [900, 200],
      "credentials": {
        "anthropicApi": {
          "id": "REPLACE_ME_ANTHROPIC_CRED_ID",
          "name": "Anthropic Claude"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const review = $('Extract Review').first().json;\nconst raw = $input.first().json.content?.[0]?.text || $input.first().json.text || '';\nlet parsed = { response: '', tone: 'neutral', flag_for_human: false };\ntry {\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  if (m) parsed = { ...parsed, ...JSON.parse(m[0]) };\n} catch (e) {}\nreturn [{ json: { ...review, suggestion: parsed } }];"
      },
      "id": "node-merge",
      "name": "Merge Suggestion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $vars.TELEGRAM_CHAT_BEWERTUNGEN }}",
        "text": "=⭐️ *Neue Bewertung – {{ $json.rating }}/10*\n*Apartment:* {{ $json.propertyName }}\n*Gast:* {{ $json.guestName }}\n\n*Positiv:* {{ $json.positive || '—' }}\n*Negativ:* {{ $json.negative || '—' }}\n\n*Antwort-Vorschlag ({{ $json.suggestion.tone }}):*\n{{ $json.suggestion.response }}\n\n{{ $json.suggestion.flag_for_human ? '⚠️ *Bitte manuell prüfen.*' : '' }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  { "additionalFields": { "callback_data": "={{ 'review_send:' + $json.reviewId }}" }, "text": "✅ Senden" },
                  { "additionalFields": { "callback_data": "={{ 'review_edit:' + $json.reviewId }}" }, "text": "✏️ Bearbeiten" }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_web_page_preview": true
        }
      },
      "id": "node-tg",
      "name": "Telegram → Bewertungen",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1380, 200],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Move-in2Stay Bot"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "ok"
      },
      "id": "node-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1620, 200]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseCode": 401,
        "responseBody": "invalid signature"
      },
      "id": "node-deny",
      "name": "Deny Invalid Signature",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [660, 460]
    }
  ],
  "connections": {
    "Webhook – Booking Review": {
      "main": [[{ "node": "Verify Signature", "type": "main", "index": 0 }]]
    },
    "Verify Signature": {
      "main": [
        [{ "node": "Extract Review", "type": "main", "index": 0 }],
        [{ "node": "Deny Invalid Signature", "type": "main", "index": 0 }]
      ]
    },
    "Extract Review": {
      "main": [[{ "node": "Claude – Response", "type": "main", "index": 0 }]]
    },
    "Claude – Response": {
      "main": [[{ "node": "Merge Suggestion", "type": "main", "index": 0 }]]
    },
    "Merge Suggestion": {
      "main": [[{ "node": "Telegram → Bewertungen", "type": "main", "index": 0 }]]
    },
    "Telegram → Bewertungen": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": false
  },
  "tags": [
    { "name": "movein2stay" },
    { "name": "booking.com" },
    { "name": "reviews" }
  ]
}
