{
  "name": "01 – E-Mail Classifier & Telegram Router",
  "nodes": [
    {
      "parameters": {
        "postProcessAction": "nothing",
        "options": {}
      },
      "id": "node-imap-trigger",
      "name": "Email Trigger (IMAP)",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [240, 300],
      "credentials": {
        "imap": {
          "id": "REPLACE_ME_IMAP_CRED_ID",
          "name": "Move-in2Stay IMAP"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const data = item.json;\n  const headers = data.headers || {};\n  const subject = (headers.subject || data.subject || '').toString();\n  const from = (headers.from || data.from || '').toString();\n  const to = (headers.to || data.to || '').toString();\n  const text = (data.text || data.textPlain || data.html || '').toString();\n\n  return {\n    json: {\n      messageId: headers['message-id'] || data.messageId || '',\n      receivedAt: data.date || new Date().toISOString(),\n      subject: subject.trim(),\n      from: from.trim(),\n      to: to.trim(),\n      bodyPreview: text.replace(/\\s+/g, ' ').slice(0, 4000)\n    }\n  };\n});"
      },
      "id": "node-normalize",
      "name": "Normalize Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "create",
        "model": "claude-sonnet-4-6",
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Du bist ein Klassifikator für eingehende E-Mails einer Ferienwohnungs-Vermietung (Move-in2Stay).\n\nKlassifiziere die folgende E-Mail in GENAU eine Kategorie:\n- BUCHUNG: Konkrete Buchungsbestätigung oder Reservierung (z. B. von Booking.com, Lodgify, Airbnb).\n- ANFRAGE: Anfrage nach Verfügbarkeit, Preisen, Langzeit, Gruppen, etc.\n- BEWERTUNG: Gast-Bewertung oder Aufforderung zur Bewertung.\n- SONSTIGES: Spam, Newsletter, Rechnungen, alles andere.\n\nAntworte ausschließlich als JSON-Objekt mit folgendem Schema:\n{\n  \"category\": \"BUCHUNG\" | \"ANFRAGE\" | \"BEWERTUNG\" | \"SONSTIGES\",\n  \"confidence\": number (0-1),\n  \"summary\": string (max 280 Zeichen, Deutsch, sachlich),\n  \"action_required\": boolean,\n  \"suggested_reply\": string | null\n}\n\nE-MAIL:\nVon: {{ $json.from }}\nAn: {{ $json.to }}\nBetreff: {{ $json.subject }}\nEmpfangen: {{ $json.receivedAt }}\n\n{{ $json.bodyPreview }}"
            }
          ]
        },
        "options": {
          "maxTokens": 600,
          "temperature": 0.1
        }
      },
      "id": "node-claude-classify",
      "name": "Claude – Classify",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [700, 300],
      "credentials": {
        "anthropicApi": {
          "id": "REPLACE_ME_ANTHROPIC_CRED_ID",
          "name": "Anthropic Claude"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse Claude's JSON response and merge with original email\nconst items = $input.all();\nreturn items.map(item => {\n  const original = item.json.original || item.json;\n  let parsed = { category: 'SONSTIGES', confidence: 0, summary: '', action_required: false, suggested_reply: null };\n  const raw = item.json.content?.[0]?.text || item.json.text || item.json.message || '';\n  try {\n    const match = raw.match(/\\{[\\s\\S]*\\}/);\n    if (match) parsed = { ...parsed, ...JSON.parse(match[0]) };\n  } catch (e) {\n    parsed.summary = 'Klassifikation fehlgeschlagen: ' + (e.message || 'unknown');\n  }\n  return {\n    json: {\n      ...original,\n      classification: parsed\n    }\n  };\n});"
      },
      "id": "node-parse-classification",
      "name": "Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "strict" },
                "conditions": [
                  {
                    "id": "cond-buchung",
                    "leftValue": "={{ $json.classification.category }}",
                    "rightValue": "BUCHUNG",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "BUCHUNG"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "strict" },
                "conditions": [
                  {
                    "id": "cond-anfrage",
                    "leftValue": "={{ $json.classification.category }}",
                    "rightValue": "ANFRAGE",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "ANFRAGE"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "typeValidation": "strict" },
                "conditions": [
                  {
                    "id": "cond-bewertung",
                    "leftValue": "={{ $json.classification.category }}",
                    "rightValue": "BEWERTUNG",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "BEWERTUNG"
            }
          ]
        },
        "fallbackOutput": "extra",
        "options": {
          "renameFallbackOutput": "SONSTIGES"
        }
      },
      "id": "node-switch",
      "name": "Route by Category",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1180, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $vars.TELEGRAM_CHAT_BUCHUNGEN }}",
        "text": "=📅 *Neue Buchung*\n\n*Von:* {{ $json.from }}\n*Betreff:* {{ $json.subject }}\n\n{{ $json.classification.summary }}\n\n_Confidence: {{ $json.classification.confidence }}_",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_web_page_preview": true
        }
      },
      "id": "node-tg-buchung",
      "name": "Telegram → Buchungen",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1440, 100],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Move-in2Stay Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $vars.TELEGRAM_CHAT_ANFRAGEN }}",
        "text": "=✉️ *Neue Anfrage*\n\n*Von:* {{ $json.from }}\n*Betreff:* {{ $json.subject }}\n\n{{ $json.classification.summary }}\n\n{{ $json.classification.suggested_reply ? '*Vorschlag:*\\n' + $json.classification.suggested_reply : '_Kein Antwort-Vorschlag._' }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_web_page_preview": true
        }
      },
      "id": "node-tg-anfrage",
      "name": "Telegram → Anfragen",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1440, 280],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Move-in2Stay Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $vars.TELEGRAM_CHAT_BEWERTUNGEN }}",
        "text": "=⭐️ *Neue Bewertung / Bewertungs-Anfrage*\n\n*Von:* {{ $json.from }}\n*Betreff:* {{ $json.subject }}\n\n{{ $json.classification.summary }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_web_page_preview": true
        }
      },
      "id": "node-tg-bewertung",
      "name": "Telegram → Bewertungen",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1440, 460],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Move-in2Stay Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $vars.TELEGRAM_CHAT_SONSTIGES }}",
        "text": "=📥 *Sonstiges*\n\n*Von:* {{ $json.from }}\n*Betreff:* {{ $json.subject }}\n\n{{ $json.classification.summary }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_web_page_preview": true
        }
      },
      "id": "node-tg-sonstiges",
      "name": "Telegram → Sonstiges",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1440, 640],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Move-in2Stay Bot"
        }
      }
    }
  ],
  "connections": {
    "Email Trigger (IMAP)": {
      "main": [[{ "node": "Normalize Email", "type": "main", "index": 0 }]]
    },
    "Normalize Email": {
      "main": [[{ "node": "Claude – Classify", "type": "main", "index": 0 }]]
    },
    "Claude – Classify": {
      "main": [[{ "node": "Parse Classification", "type": "main", "index": 0 }]]
    },
    "Parse Classification": {
      "main": [[{ "node": "Route by Category", "type": "main", "index": 0 }]]
    },
    "Route by Category": {
      "main": [
        [{ "node": "Telegram → Buchungen", "type": "main", "index": 0 }],
        [{ "node": "Telegram → Anfragen", "type": "main", "index": 0 }],
        [{ "node": "Telegram → Bewertungen", "type": "main", "index": 0 }],
        [{ "node": "Telegram → Sonstiges", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": false
  },
  "tags": [
    { "name": "movein2stay" },
    { "name": "email" },
    { "name": "telegram" }
  ]
}
